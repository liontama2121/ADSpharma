---
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Carousel from "../components/Carousel.astro";
import Marquee from "../components/Marquee.astro";
import { getGlobal, waHref } from "../lib/site";

const entry = await getEntry("nosotros", "nosotros");
if (!entry) throw new Error("Falta src/content/paginas/nosotros.json");
const pagina = entry.data;
const global = await getGlobal();

const lineas = (await getCollection("lineas"))
  .filter((l) => l.data.visibleEnHome)
  .sort((a, b) => a.data.orden - b.data.orden);
---

<Base seo={pagina.seo} activeIndex={2}>
  <main>
    <section class="hero-sm container">
      <h1 class="sec-title h-morado">{pagina.intro.titulo}</h1>
      <h2 class="sec-sub">{pagina.intro.subtitulo}</h2>
      <p>{pagina.intro.texto}</p>
    </section>

    <section class="container">
      <div class="cards-3 reveal-stagger reveal">
        {pagina.valores.map((v) => (
          <div class="glass-card">
            <h3>{v.titulo}</h3>
            <p>{v.texto}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="container">
      <div class="section-head reveal">
        <h1 class="sec-title h-morado">{pagina.lineas.titulo}</h1>
        <p>{pagina.lineas.texto}</p>
      </div>
      <Carousel trackClass="lineas-extended">
        {lineas.map((l) => (
          <div class="glass-card" style={`--linea-color: ${l.data.color};`}>
            <span class="tag-linea" style={`--linea-color: ${l.data.color};`}>{l.data.nombre}</span>
            <h3 style="margin-top:14px;">{l.data.tituloNosotros}</h3>
            <p>{l.data.descripcionNosotros}</p>
          </div>
        ))}
      </Carousel>
    </section>

    <section>
      <div class="container section-head reveal" style="margin-bottom:30px;">
        <h1 class="sec-title h-morado">{pagina.clientes.titulo}</h1>
      </div>
      <Marquee items={global.clientesInstitucionales} />
    </section>

    <section class="cta-contacto">
      <div class="container contenido reveal">
        <span class="section-eyebrow">{pagina.cta.eyebrow}</span>
        <h2>{pagina.cta.titulo}</h2>
        <p>{pagina.cta.texto}</p>
        <a class="btn btn-wa" href={waHref(global.whatsapp)} target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.5 3.5A11.9 11.9 0 0 0 3 18.5L1.5 24l5.7-1.5A11.9 11.9 0 1 0 20.5 3.5Z"/></svg>
          {pagina.cta.boton}
        </a>
      </div>
    </section>
  </main>
</Base>
